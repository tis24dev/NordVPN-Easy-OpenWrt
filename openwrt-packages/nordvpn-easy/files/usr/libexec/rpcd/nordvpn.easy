#!/bin/sh

INIT_SCRIPT="${NORDVPN_EASY_INIT_SCRIPT:-/etc/init.d/nordvpn-easy}"
PUBLIC_IP_POLL_SCRIPT="${NORDVPN_EASY_PUBLIC_IP_POLL_SCRIPT:-/usr/libexec/nordvpn-easy/public-ip-poll.sh}"
UCI_CONFIG='nordvpn_easy'
UCI_SECTION='main'
LIB_DIR="${NORDVPN_EASY_LIB_DIR:-/usr/libexec/nordvpn-easy/lib}"
LOCK_DIR="${NORDVPN_EASY_LOCK_DIR:-/tmp/nordvpn-easy.lock}"
NORDVPN_EASY_RC_BUSY="${NORDVPN_EASY_RC_BUSY:-75}"

# shellcheck disable=SC1090
. "${LIB_DIR}/config-context.sh" || exit 1
# shellcheck disable=SC1090
. "${LIB_DIR}/runtime.sh" || exit 1

rpc_json_string() {
	printf '%s' "$1" | jq -Rs .
}

rpc_read_input() {
	RPC_INPUT="$(cat 2>/dev/null || printf '%s' '{}')"
	[ -n "$RPC_INPUT" ] || RPC_INPUT='{}'
}

rpc_input_value() {
	printf '%s' "$RPC_INPUT" | jq -er "$1 // empty" 2>/dev/null || true
}

rpc_input_bool() {
	printf '%s' "$RPC_INPUT" | jq -er "if ($1 == true or $1 == \"1\" or $1 == 1) then \"1\" else \"0\" end" 2>/dev/null || printf '%s\n' '0'
}

rpc_command_result() {
	local action="$1"
	local tmp_dir out_file err_file rc stdout_json stderr_json
	local cached_error message_json reason_json
	local busy='false' skipped='false' reason=''
	local holder_pid='' holder_action='' holder_age_seconds='0'
	shift

	tmp_dir="$(mktemp -d /tmp/nordvpn-easy.rpc.XXXXXX 2>/dev/null)" || {
		printf '{"action":%s,"code":1,"success":false,"busy":false,"skipped":false,"reason":"","holder_pid":"","holder_action":"","holder_age_seconds":0,"stdout":"","stderr":"could not create rpc temp directory","message":"could not create rpc temp directory"}\n' "$(rpc_json_string "$action")"
		return 0
	}
	out_file="${tmp_dir}/stdout"
	err_file="${tmp_dir}/stderr"

	"$@" > "$out_file" 2> "$err_file"
	rc=$?

	if [ "$rc" -eq "$NORDVPN_EASY_RC_BUSY" ]; then
		busy='true'
		skipped='true'
		reason='operation_busy'
		nordvpn_easy_load_lock_metadata "$LOCK_DIR"
		holder_pid="${OPERATION_LOCK_PID:-}"
		holder_action="${OPERATION_LOCK_ACTION:-}"
		holder_age_seconds="${OPERATION_LOCK_AGE_SECONDS:-0}"
		if [ ! -s "$err_file" ]; then
			printf 'operation busy: another NordVPN Easy operation is running (holder_action=%s, holder_pid=%s, holder_age_seconds=%s)' \
				"${holder_action:-unknown}" \
				"${holder_pid:-unknown}" \
				"${holder_age_seconds:-0}" > "$err_file"
		fi
	elif [ "$rc" -ne 0 ] && [ ! -s "$out_file" ] && [ ! -s "$err_file" ]; then
		cached_error="$(sed -n '1p' "$NORDVPN_EASY_LAST_ERROR_CACHE" 2>/dev/null || true)"
		printf '%s' "${cached_error:-${action} failed without output}" > "$err_file"
	fi

	stdout_json="$(jq -Rs . < "$out_file")"
	stderr_json="$(jq -Rs . < "$err_file")"
	reason_json="$(rpc_json_string "$reason")"
	if [ "$rc" -eq 0 ]; then
		message_json="$stdout_json"
	else
		message_json="$stderr_json"
	fi
	rm -rf -- "$tmp_dir"

	printf '{"action":%s,"code":%s,"success":%s,"busy":%s,"skipped":%s,"reason":%s,"holder_pid":%s,"holder_action":%s,"holder_age_seconds":%s,"stdout":%s,"stderr":%s,"message":%s}\n' \
		"$(rpc_json_string "$action")" \
		"$rc" \
		"$([ "$rc" -eq 0 ] && printf '%s' 'true' || printf '%s' 'false')" \
		"$busy" \
		"$skipped" \
		"$reason_json" \
		"$(rpc_json_string "$holder_pid")" \
		"$(rpc_json_string "$holder_action")" \
		"${holder_age_seconds:-0}" \
		"$stdout_json" \
		"$stderr_json" \
		"$message_json"
}

rpc_load_runtime_context_readonly() {
	local option raw_value normalized_value env_name desired_enabled

	for option in $(nordvpn_easy_runtime_options); do
		raw_value="$(nordvpn_easy_read_uci_option "$UCI_CONFIG" "$UCI_SECTION" "$option")"
		normalized_value="$(nordvpn_easy_normalize_value "$option" "$raw_value")"
		env_name="$(nordvpn_easy_env_name "$option")"
		nordvpn_easy_assign_shell_var "$env_name" "$normalized_value"
	done

	raw_value="$(nordvpn_easy_read_uci_option "$UCI_CONFIG" "$UCI_SECTION" 'enabled')"
	desired_enabled="$(nordvpn_easy_normalize_value 'enabled' "$raw_value")"
	nordvpn_easy_assign_shell_var 'DESIRED_ENABLED' "$desired_enabled"
	nordvpn_easy_assign_shell_var 'ENABLED' "$desired_enabled"
	# Mirrors config-context.sh for status emitters and debug summaries.
	# shellcheck disable=SC2034
	CONFIG_CONTEXT_SOURCE="uci:${UCI_CONFIG}.${UCI_SECTION}:readonly"
}

rpc_status() {
	if rpc_load_runtime_context_readonly >/dev/null 2>&1; then
		nordvpn_easy_emit_status_json
		nordvpn_easy_write_status_cache >/dev/null 2>&1 || true
		return 0
	fi

	# Even on a read-only context-load failure, emit the canonical status
	# document: it still sources the WireGuard runtime snapshot and the
	# connect-apply / public-verification caches the LuCI poller depends on, so
	# those blocks are not silently dropped.
	if nordvpn_easy_emit_status_json 2>/dev/null; then
		return 0
	fi

	# Last resort, only if the canonical emitter itself fails. Emit a minimal
	# fail-safe (everything reads as down); manager-data.js parseLocalStatus fills
	# safe defaults for every other field, so we do NOT hand-maintain a second
	# full copy of the status contract here (it had already drifted from the
	# emitter, dropping the connect_apply_* / public_verification_* blocks).
	printf '{"updated_at":%s,"state":"failed","desired_enabled":false,"enabled":false,"runtime_disabled":true,"interface_disabled":true,"runtime_configured":false,"connected":false,"vpn_status":"error","operation_status":"idle","last_error":"failed to load runtime context from UCI"}\n' \
		"$(date +%s 2>/dev/null || printf '%s' '0')"
}

rpc_refresh_countries() {
	local force action

	force="$(rpc_input_bool '.force')"
	if [ "$force" = '1' ]; then
		action='refresh_countries_force'
	else
		action='refresh_countries'
	fi

	rpc_command_result "$action" "$INIT_SCRIPT" "$action"
}

rpc_refresh_servers() {
	local country force

	country="$(rpc_input_value '.country')"
	force="$(rpc_input_bool '.force')"
	rpc_command_result 'server_catalog' "$INIT_SCRIPT" server_catalog "$country" "$force"
}

rpc_connect() {
	rpc_command_result 'connect' "$INIT_SCRIPT" connect
}

rpc_start_connect() {
	local async_log_dir async_log
	local holder_pid='' holder_action='' holder_age_seconds='0'
	local reason='' message='Connect started in background; poll status for completion.'
	local log_size=''

	async_log_dir='/tmp/run/nordvpn-easy'
	async_log="${async_log_dir}/start-connect.log"
	mkdir -p "$async_log_dir" 2>/dev/null || true

	# Cap the fire-and-forget background log so it cannot grow unbounded across
	# repeated connects (rotate to .1 past 256 KiB).
	if [ -f "$async_log" ]; then
		log_size="$(wc -c < "$async_log" 2>/dev/null || printf '0')"
		case "$log_size" in
			''|*[!0-9]*) log_size=0 ;;
		esac
		if [ "$log_size" -gt 262144 ]; then
			mv "$async_log" "${async_log}.1" 2>/dev/null || : > "$async_log"
		fi
	fi

	# The connect-apply-result lifecycle is owned solely by the init
	# connect_apply_guard_begin (run by begin_connect_apply and by the background
	# connect worker). Do NOT begin it here: begin_connect_apply has already
	# marked it pending before start_connect, and beginning ahead of the busy
	# check below would leave a phantom 'pending' when the call is rejected busy.
	nordvpn_easy_load_lock_metadata "$LOCK_DIR"
	case "$OPERATION_LOCK_STATE" in
		held|stale_recovered)
			holder_pid="${OPERATION_LOCK_PID:-}"
			holder_action="${OPERATION_LOCK_ACTION:-}"
			holder_age_seconds="${OPERATION_LOCK_AGE_SECONDS:-0}"
			reason='operation_busy'
			printf '{"action":%s,"code":%s,"success":false,"async":false,"busy":true,"skipped":true,"reason":%s,"holder_pid":%s,"holder_action":%s,"holder_age_seconds":%s,"stdout":"","stderr":%s,"message":%s}\n' \
				"$(rpc_json_string 'start_connect')" \
				"$NORDVPN_EASY_RC_BUSY" \
				"$(rpc_json_string "$reason")" \
				"$(rpc_json_string "$holder_pid")" \
				"$(rpc_json_string "$holder_action")" \
				"${holder_age_seconds:-0}" \
				"$(rpc_json_string "operation busy: another NordVPN Easy operation is running (holder_action=${holder_action:-unknown}, holder_pid=${holder_pid:-unknown}, holder_age_seconds=${holder_age_seconds:-0})")" \
				"$(rpc_json_string "operation busy: another NordVPN Easy operation is running (holder_action=${holder_action:-unknown}, holder_pid=${holder_pid:-unknown}, holder_age_seconds=${holder_age_seconds:-0})")"
			return 0
			;;
	esac

	(
		printf '%s nordvpn-easy: start_connect background job begin (pid=%s)\n' \
			"$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || date)" \
			"$$" >> "$async_log" 2>/dev/null
		"$INIT_SCRIPT" connect >> "$async_log" 2>&1
		rc=$?
		printf '%s nordvpn-easy: start_connect background job finished rc=%s\n' \
			"$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || date)" \
			"$rc" >> "$async_log" 2>/dev/null
	) &

	printf '{"action":%s,"code":0,"success":true,"async":true,"busy":false,"skipped":false,"reason":"","holder_pid":"","holder_action":"","holder_age_seconds":0,"stdout":"","stderr":"","message":%s}\n' \
		"$(rpc_json_string 'start_connect')" \
		"$(rpc_json_string "$message")"
}

rpc_disconnect() {
	rpc_command_result 'disconnect' "$INIT_SCRIPT" disconnect
}

rpc_reconnect() {
	rpc_command_result 'reconnect' "$INIT_SCRIPT" reconnect
}

rpc_begin_connect_apply() {
	rpc_command_result 'begin_connect_apply' "$INIT_SCRIPT" begin_connect_apply
}

rpc_abort_connect_apply() {
	rpc_command_result 'abort_connect_apply' "$INIT_SCRIPT" abort_connect_apply
}

rpc_stop_vpn() {
	rpc_command_result 'stop_vpn' "$INIT_SCRIPT" stop_vpn
}

rpc_public_ip() {
	local tmp_dir out_file err_file rc stdout_json stderr_json message_json

	[ -x "$PUBLIC_IP_POLL_SCRIPT" ] || {
		printf '{"action":"public_ip","code":1,"success":false,"busy":false,"skipped":false,"reason":"","holder_pid":"","holder_action":"","holder_age_seconds":0,"stdout":"","stderr":"missing public-ip poll script","message":"missing public-ip poll script"}\n'
		return 0
	}

	tmp_dir="$(mktemp -d /tmp/nordvpn-easy.public-ip.XXXXXX 2>/dev/null)" || {
		printf '{"action":"public_ip","code":1,"success":false,"busy":false,"skipped":false,"reason":"","holder_pid":"","holder_action":"","holder_age_seconds":0,"stdout":"","stderr":"could not create public-ip temp directory","message":"could not create public-ip temp directory"}\n'
		return 0
	}
	out_file="${tmp_dir}/stdout"
	err_file="${tmp_dir}/stderr"

	"$PUBLIC_IP_POLL_SCRIPT" quiet > "$out_file" 2> "$err_file"
	rc=$?

	stdout_json="$(jq -Rs . < "$out_file")"
	stderr_json="$(jq -Rs . < "$err_file")"
	if [ "$rc" -eq 0 ]; then
		message_json="$stdout_json"
	else
		message_json="$stderr_json"
		if [ "$stderr_json" = '""' ] || [ "$stderr_json" = 'null' ] || [ -z "$stderr_json" ]; then
			message_json="$(printf 'public-ip poll script exited with code %s: %s' "$rc" "$PUBLIC_IP_POLL_SCRIPT" | jq -Rs .)"
		fi
	fi
	rm -rf -- "$tmp_dir"

	printf '{"action":%s,"code":%s,"success":%s,"busy":false,"skipped":false,"reason":"","holder_pid":"","holder_action":"","holder_age_seconds":0,"stdout":%s,"stderr":%s,"message":%s}\n' \
		"$(rpc_json_string 'public_ip')" \
		"$rc" \
		"$([ "$rc" -eq 0 ] && printf '%s' 'true' || printf '%s' 'false')" \
		"$stdout_json" \
		"$stderr_json" \
		"$message_json"
}

rpc_diagnostics_summary() {
	local tmp_dir out_file err_file rc err_msg

	tmp_dir="$(mktemp -d /tmp/nordvpn-easy.diag-summary.XXXXXX 2>/dev/null)" || {
		printf '{"generated_at":0,"success":false,"vpn_if":"wg0","primary_finding":{"code":"operational.summary_failed","message":"could not create diagnostics summary temp directory","action":""},"findings":[]}\n'
		return 0
	}
	out_file="${tmp_dir}/stdout"
	err_file="${tmp_dir}/stderr"
	"$INIT_SCRIPT" diagnostics_summary > "$out_file" 2> "$err_file"
	rc=$?
	if [ "$rc" -eq 0 ] && [ -s "$out_file" ] && jq -e . "$out_file" >/dev/null 2>&1; then
		cat "$out_file"
		rm -rf -- "$tmp_dir"
		return 0
	fi

	err_msg="$(sed -n '1p' "$err_file" 2>/dev/null || true)"
	[ -n "$err_msg" ] || err_msg='diagnostics summary failed'
	jq -n \
		--argjson generated_at "$(date +%s 2>/dev/null || printf '%s' '0')" \
		--arg message "$err_msg" \
		'{
			generated_at: $generated_at,
			success: false,
			vpn_if: "wg0",
			primary_finding: {
				code: "operational.summary_failed",
				message: $message,
				action: "Review NordVPN Easy logs and retry diagnostics export"
			},
			findings: []
		}'
	rm -rf -- "$tmp_dir"
}

rpc_diagnostics() {
	local tmp_dir log_file stderr_file rc log_json stderr_json message_json

	tmp_dir="$(mktemp -d /tmp/nordvpn-easy.diag.XXXXXX 2>/dev/null)" || {
		printf '{"code":1,"success":false,"log":"","message":"could not create diagnostics temp directory"}\n'
		return 0
	}
	log_file="${tmp_dir}/diagnostics.log"
	stderr_file="${tmp_dir}/diagnostics.stderr"
	"$INIT_SCRIPT" diagnostics_log > "$log_file" 2> "$stderr_file"
	rc=$?
	log_json="$(jq -Rs . < "$log_file")"
	stderr_json="$(jq -Rs . < "$stderr_file")"
	if [ "$rc" -eq 0 ]; then
		message_json="$log_json"
	elif [ -s "$stderr_file" ]; then
		message_json="$({ printf '%s' 'diagnostics export failed: '; cat "$stderr_file"; } | jq -Rs .)"
	else
		message_json="$(rpc_json_string 'diagnostics export failed')"
	fi
	rm -rf -- "$tmp_dir"
	printf '{"code":%s,"success":%s,"log":%s,"stdout":%s,"stderr":%s,"message":%s}\n' \
		"$rc" \
		"$([ "$rc" -eq 0 ] && printf '%s' 'true' || printf '%s' 'false')" \
		"$log_json" \
		"$log_json" \
		"$stderr_json" \
		"$message_json"
}

rpc_call() {
	local method="$1"

	rpc_read_input

	case "$method" in
		status)
			rpc_status
			;;
		connect)
			rpc_connect
			;;
		start_connect)
			rpc_start_connect
			;;
		disconnect)
			rpc_disconnect
			;;
		reconnect)
			rpc_reconnect
			;;
		begin_connect_apply)
			rpc_begin_connect_apply
			;;
		abort_connect_apply)
			rpc_abort_connect_apply
			;;
		stop_vpn)
			rpc_stop_vpn
			;;
		reconcile)
			rpc_command_result 'reconcile' "$INIT_SCRIPT" reconcile
			;;
		rotate)
			rpc_command_result 'rotate' "$INIT_SCRIPT" rotate
			;;
		setup)
			rpc_command_result 'setup' "$INIT_SCRIPT" setup
			;;
		check)
			rpc_command_result 'check' "$INIT_SCRIPT" check
			;;
		install_hooks)
			rpc_command_result 'install_hooks' "$INIT_SCRIPT" install_hooks
			;;
		remove_hooks)
			rpc_command_result 'remove_hooks' "$INIT_SCRIPT" remove_hooks
			;;
		disable_runtime)
			rpc_command_result 'disable_runtime' "$INIT_SCRIPT" disable_runtime
			;;
		refresh_countries)
			rpc_refresh_countries
			;;
		refresh_servers|server_catalog)
			rpc_refresh_servers
			;;
		public_ip)
			rpc_public_ip
			;;
		diagnostics|diagnostics_log)
			rpc_diagnostics
			;;
		diagnostics_summary)
			rpc_diagnostics_summary
			;;
		*)
			printf '{"code":1,"success":false,"message":%s}\n' "$(rpc_json_string "unknown method: $method")"
			;;
	esac
}

case "$1" in
	list)
		cat <<'EOF'
{
  "status": {},
  "connect": {},
  "start_connect": {},
  "disconnect": {},
  "reconnect": {},
  "begin_connect_apply": {},
  "abort_connect_apply": {},
  "stop_vpn": {},
  "reconcile": {},
  "rotate": {},
  "setup": {},
  "check": {},
  "install_hooks": {},
  "remove_hooks": {},
  "disable_runtime": {},
  "refresh_countries": { "force": "Boolean" },
  "refresh_servers": { "country": "String", "force": "Boolean" },
  "server_catalog": { "country": "String", "force": "Boolean" },
  "public_ip": {},
  "diagnostics": {},
  "diagnostics_log": {},
  "diagnostics_summary": {}
}
EOF
		;;
	call)
		rpc_call "$2"
		;;
	*)
		exit 1
		;;
esac
