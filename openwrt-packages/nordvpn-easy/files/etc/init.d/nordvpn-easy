#!/bin/sh /etc/rc.common

# OpenWrt rc.common consumes these metadata variables.
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10

. /lib/functions.sh

SERVICE_NAME='nordvpn-easy'
UCI_CONFIG='nordvpn_easy'
UCI_SECTION='main'
RUNTIME_CONFIG='/var/etc/nordvpn-easy.conf'
CORE_SCRIPT='/usr/libexec/nordvpn-easy/core.sh'
PUBLIC_IP_POLL_SCRIPT='/usr/libexec/nordvpn-easy/public-ip-poll.sh'
CONFIG_CONTEXT_LIB='/usr/libexec/nordvpn-easy/lib/config-context.sh'
CRON_PATH='/etc/cron.d/nordvpn-easy'
HOTPLUG_PATH='/etc/hotplug.d/iface/95-nordvpn-easy'
RUN_STATE_DIR='/tmp/run/nordvpn-easy'
CONNECT_SETUP_CONFIG_CACHE="${RUN_STATE_DIR}/connect-setup.conf"
CONNECT_APPLY_GUARD="${RUN_STATE_DIR}/connect-apply-guard"
CONNECT_APPLY_RESULT="${RUN_STATE_DIR}/connect-apply-result"
RUNTIME_LOCK_DIR='/tmp/nordvpn-easy.lock'
SERVICE_BACKEND_PAYLOAD_SIGNATURE='render-contract-v3'
NORDVPN_EASY_RC_BUSY="${NORDVPN_EASY_RC_BUSY:-75}"
# OpenWrt rc.common consumes the command/help metadata.
# shellcheck disable=SC2034
EXTRA_COMMANDS='connect disconnect stop_vpn reconnect reconcile setup check rotate refresh_countries refresh_countries_force server_catalog public_ip operation_status vpn_status status_json diagnostics_log diagnostics_summary install_hooks remove_hooks disable_runtime render_runtime_config'
# shellcheck disable=SC2034
EXTRA_HELP='  connect               Enable, run setup, then install hooks transactionally
  disconnect            Disable runtime and remove hooks
  stop_vpn              Stop VPN, clear caches, and remove WireGuard runtime config
  reconnect             Compatibility alias for stop_vpn then connect
  reconcile             Synchronize runtime state with the saved UCI config
  setup                 Run setup immediately
  check                 Run one health check immediately
  rotate                Force server rotation immediately
  refresh_countries     Refresh the cached NordVPN country list
  refresh_countries_force Force-refresh the cached NordVPN country list
  server_catalog [country] [force] Print the cached or refreshed NordVPN server catalog JSON
  public_ip             Check the current public IP and print a JSON cache snapshot
  operation_status      Print whether a NordVPN Easy operation is running
  vpn_status            Print VPN runtime status (active/activating/inactive)
  status_json           Print local VPN runtime status as JSON
  diagnostics_log       Print filtered NordVPN Easy log output
  diagnostics_summary   Print structured diagnostics summary as JSON
  install_hooks         Install cron and hotplug hooks
  remove_hooks          Remove cron and hotplug hooks
  disable_runtime       Disable the VPN interface and remove hooks
  render_runtime_config Render the temporary shell config'

CONFIG_CONTEXT_LIB_LOADED=0

load_config_context_library() {
	[ "$CONFIG_CONTEXT_LIB_LOADED" -eq 1 ] && return 0
	[ -r "$CONFIG_CONTEXT_LIB" ] || {
		printf '%s\n' "nordvpn-easy: missing config context library $CONFIG_CONTEXT_LIB" >&2
		return 1
	}

	# shellcheck disable=SC1090
	. "$CONFIG_CONTEXT_LIB" || return 1
	CONFIG_CONTEXT_LIB_LOADED=1
}

load_service_config() {
	load_config_context_library || return 1
	nordvpn_easy_load_service_context 'cfg_' "$UCI_CONFIG" "$UCI_SECTION"
}

nordvpn_easy_service_backend_payload_summary() {
	local lib_payload='unavailable'
	local payload_match='0'

	lib_payload="$(nordvpn_easy_backend_payload_signature 2>/dev/null || printf '%s' 'unavailable')"
	[ "$SERVICE_BACKEND_PAYLOAD_SIGNATURE" = "$lib_payload" ] && payload_match='1'

	printf '%s' "service_payload=${SERVICE_BACKEND_PAYLOAD_SIGNATURE}, lib_payload=${lib_payload}, payload_match=${payload_match}"
}

render_runtime_config() {
	local target_config="${1:-$RUNTIME_CONFIG}"
	local written_options=0

	load_service_config || return 1
	log_service_info "service: rendering runtime config to $target_config ($(nordvpn_easy_service_debug_summary 'cfg_'), $(nordvpn_easy_service_backend_payload_summary))"

	nordvpn_easy_render_runtime_config "$target_config" 'cfg_' written_options || {
		log_service_error "service: failed to render runtime config into $target_config"
		return 1
	}

	nordvpn_easy_validate_runtime_config "$target_config" 'cfg_' || {
		log_service_error "service: rendered runtime config failed validation at $target_config ($(nordvpn_easy_runtime_file_debug_summary "$target_config"), $(nordvpn_easy_runtime_config_validation_summary), $(nordvpn_easy_service_backend_payload_summary))"
		return 1
	}

	log_service_info "service: runtime config rendered at $target_config (written_options=$written_options, $(nordvpn_easy_runtime_file_debug_summary "$target_config"), $(nordvpn_easy_runtime_config_validation_summary), $(nordvpn_easy_service_backend_payload_summary))"
}

run_core_action() {
	local action="$1"
	local action_started_at=''
	local action_finished_at=''
	local action_duration='unknown'
	local action_temp_dir=''
	local action_config=''
	local written_options=0
	local failure_log_mode="${RUN_CORE_ACTION_FAILURE_LOG_MODE:-error}"
	local busy_is_ok="${RUN_CORE_ACTION_BUSY_IS_OK:-${NORDVPN_EASY_BUSY_IS_OK:-0}}"
	local action_log_mode='verbose'
	local direct_uci_config=0
	local rc=0
	shift

	[ -x "$CORE_SCRIPT" ] || {
		echo "Missing executable core script: $CORE_SCRIPT" >&2
		return 1
	}

	case "$action" in
		stop_vpn)
			direct_uci_config=1
			;;
	esac

	if [ "$direct_uci_config" -eq 1 ]; then
		load_config_context_library || return 1
	elif [ "$action" = 'setup' ] && [ -f "${NORDVPN_EASY_SETUP_CONFIG_CACHE:-$CONNECT_SETUP_CONFIG_CACHE}" ]; then
		load_service_config || return 1
		action_config="${NORDVPN_EASY_SETUP_CONFIG_CACHE:-$CONNECT_SETUP_CONFIG_CACHE}"
		if ! nordvpn_easy_validate_runtime_config "$action_config" 'cfg_'; then
			log_service_info "apply: cached setup config at $action_config is stale; rendering a fresh config"
			action_config=''
		fi
	fi

	if [ "$direct_uci_config" -eq 1 ]; then
		:
	elif [ -n "$action_config" ]; then
		log_service_info "apply: using cached setup config at $action_config ($(nordvpn_easy_runtime_file_debug_summary "$action_config"), $(nordvpn_easy_runtime_config_validation_summary), $(nordvpn_easy_service_backend_payload_summary))"
	else
		load_service_config || return 1
		nordvpn_easy_mktemp_dir "core-${action}" action_temp_dir || {
			log_service_error "apply: failed to create temporary config workspace for core action '$action'"
			return 1
		}
		action_config="$(nordvpn_easy_temp_file_path "$action_temp_dir" "nordvpn-easy.${action}.conf")"
		nordvpn_easy_render_runtime_config "$action_config" 'cfg_' written_options || {
			rm -rf -- "$action_temp_dir"
			log_service_error "apply: failed to render temporary config for core action '$action'"
			return 1
		}
		nordvpn_easy_validate_runtime_config "$action_config" 'cfg_' || {
			log_service_error "apply: rendered temporary config for '$action' failed validation at $action_config ($(nordvpn_easy_runtime_file_debug_summary "$action_config"), $(nordvpn_easy_runtime_config_validation_summary), $(nordvpn_easy_service_backend_payload_summary))"
			rm -rf -- "$action_temp_dir"
			return 1
		}
	fi

	case "$action:${1:-}" in
		status_json:*|operation_status:*|vpn_status:*|diagnostics_log:*|diagnostics_summary:*)
			action_log_mode='quiet'
			;;
		public_ip:quiet)
			action_log_mode='quiet'
			;;
	esac

	action_started_at="$(date +%s 2>/dev/null || printf '%s' '0')"
	if [ "$action_log_mode" != 'quiet' ]; then
		log_service_info "apply: running core action '$action' (args=$(nordvpn_easy_debug_cli_args "$@"))"
		if [ "$direct_uci_config" -eq 1 ]; then
			log_service_info "apply: core action '$action' will load the current UCI runtime context directly"
		elif [ -z "$action_temp_dir" ] && [ "$action" = 'setup' ]; then
			log_service_info "apply: core action context for $action: $(nordvpn_easy_service_debug_summary 'cfg_')"
		else
			log_service_info "apply: core action context for $action: $(nordvpn_easy_service_debug_summary 'cfg_')"
			log_service_info "apply: rendered temporary config for '$action' at $action_config (written_options=$written_options, $(nordvpn_easy_runtime_file_debug_summary "$action_config"), $(nordvpn_easy_runtime_config_validation_summary), $(nordvpn_easy_service_backend_payload_summary))"
		fi
	fi
	if [ "$action" = 'setup' ] && [ -f "$CONNECT_APPLY_GUARD" ]; then
		export NORDVPN_EASY_CONNECT_APPLY=1
	fi
	if [ "$direct_uci_config" -eq 1 ]; then
		"$CORE_SCRIPT" "$action" "$@"
	else
		"$CORE_SCRIPT" "$action" --config "$action_config" "$@"
	fi
	rc=$?
	unset NORDVPN_EASY_CONNECT_APPLY 2>/dev/null || true
	[ -z "$action_temp_dir" ] || rm -rf -- "$action_temp_dir"
	action_finished_at="$(date +%s 2>/dev/null || printf '%s' '0')"
	case "$action_started_at" in
		''|*[!0-9]*)
			action_duration='unknown'
			;;
		*)
			case "$action_finished_at" in
				''|*[!0-9]*)
					action_duration='unknown'
					;;
				*)
					action_duration=$((action_finished_at - action_started_at))
					;;
			esac
			;;
	esac

	if [ "$rc" -eq 0 ]; then
		if [ "$action_log_mode" != 'quiet' ]; then
			log_service_info "apply: core action '$action' completed successfully (duration=${action_duration}s)"
		fi
	elif [ "$rc" -eq "$NORDVPN_EASY_RC_BUSY" ]; then
		if [ "$busy_is_ok" = '1' ]; then
			[ "$action_log_mode" = 'quiet' ] || log_service_info "apply: core action '$action' skipped because another operation is running (duration=${action_duration}s, rc=$rc)"
			return 0
		fi
		[ "$action_log_mode" = 'quiet' ] || log_service_info "apply: core action '$action' skipped because another operation is running (duration=${action_duration}s, rc=$rc)"
	elif [ "$failure_log_mode" = 'info' ]; then
		log_service_info "apply: core action '$action' failed but is deferred (duration=${action_duration}s, rc=$rc)"
	else
		log_service_error "apply: BLOCKER: core action '$action' failed (duration=${action_duration}s, rc=$rc)"
	fi
	return "$rc"
}

restart_cron_service() {
	/etc/init.d/cron restart >/dev/null 2>&1 ||
	/etc/init.d/cron reload >/dev/null 2>&1 ||
	true
}

connect_apply_guard_begin() {
	mkdir -p "$RUN_STATE_DIR" 2>/dev/null || true
	: > "$CONNECT_APPLY_GUARD" 2>/dev/null || true
	nordvpn_easy_connect_apply_result_begin "$CONNECT_APPLY_RESULT" 2>/dev/null || true
}

connect_apply_guard_end() {
	rm -f "$CONNECT_APPLY_GUARD" 2>/dev/null || true
}

connect_apply_result_finish() {
	local rc="${1:-1}"

	load_service_config || return 1
	nordvpn_easy_connect_apply_result_finish "$CONNECT_APPLY_RESULT" "$rc" "$cfg_vpn_country" 2>/dev/null || true
	if [ "$rc" -eq 0 ]; then
		nordvpn_easy_clear_stale_runtime_lock "$RUNTIME_LOCK_DIR" 2>/dev/null || true
	fi
}

prepare_connect_setup_config_cache() {
	local written_options=0

	mkdir -p "$RUN_STATE_DIR" 2>/dev/null || true
	nordvpn_easy_render_runtime_config "$CONNECT_SETUP_CONFIG_CACHE" 'cfg_' written_options || {
		log_service_error "apply: failed to render cached setup config at $CONNECT_SETUP_CONFIG_CACHE"
		return 1
	}
	nordvpn_easy_validate_runtime_config "$CONNECT_SETUP_CONFIG_CACHE" 'cfg_' || {
		log_service_error "apply: cached setup config failed validation at $CONNECT_SETUP_CONFIG_CACHE ($(nordvpn_easy_runtime_file_debug_summary "$CONNECT_SETUP_CONFIG_CACHE"), $(nordvpn_easy_runtime_config_validation_summary), $(nordvpn_easy_service_backend_payload_summary))"
		return 1
	}
	log_service_info "apply: cached setup config at $CONNECT_SETUP_CONFIG_CACHE (written_options=$written_options, $(nordvpn_easy_runtime_file_debug_summary "$CONNECT_SETUP_CONFIG_CACHE"), $(nordvpn_easy_runtime_config_validation_summary), $(nordvpn_easy_service_backend_payload_summary))"
}

write_desired_cron_hook_to() {
	local target="$1"
	local effective_cron_schedule=''
	local config_ready="${2:-0}"

	if [ "$config_ready" != '1' ]; then
		load_service_config
	fi

	if [ "$cfg_enabled" -eq 1 ] && [ -n "$cfg_check_cron_schedule" ]; then
		if ! validate_cron_schedule "$cfg_check_cron_schedule"; then
			return 1
		fi

		effective_cron_schedule="$(normalize_cron_schedule "$cfg_check_cron_schedule")"
		cat > "$target" <<EOF
$effective_cron_schedule NORDVPN_EASY_BUSY_IS_OK=1 /etc/init.d/$SERVICE_NAME check 2>&1 | logger -t $SERVICE_NAME-cron
EOF
	else
		: > "$target"
	fi
}

log_service_error() {
	local message="$1"

	case "$message" in
		service:*|apply:*|healthcheck:*|poll:*|runtime:*|diagnostics:*)
			;;
		*)
			message="service: $message"
			;;
	esac

	logger -t "$SERVICE_NAME" "$message"
	echo "$SERVICE_NAME: $message" >&2
}

log_service_info() {
	local message="$1"

	case "$message" in
		service:*|apply:*|healthcheck:*|poll:*|runtime:*|diagnostics:*)
			;;
		*)
			message="service: $message"
			;;
	esac

	logger -t "$SERVICE_NAME" "$message"
}

validate_cron_schedule() {
	local schedule="$1"
	local validation_output=''

	if validation_output="$(
		printf '%s' "$schedule" | awk '
		BEGIN {
			valid = 1
			error = ""
			split("59 23 31 12 7", maxv, " ")
			split("0 0 1 1 0", minv, " ")
			split("minute hour day-of-month month day-of-week", field_name, " ")
		}
		function fail(msg) {
			if (valid) {
				valid = 0
				error = msg
			}
		}
		NR > 1 { fail("schedule must be a single line"); exit }
		{
			if (NF != 5) { fail("expected exactly 5 cron fields"); exit }
			for (i = 1; i <= NF; i++) {
				f = $i
				if (f == "*") continue
				if (f ~ /^\*\/[0-9]+$/) {
					step = substr(f, 3) + 0
					if (step < 1 || step > maxv[i] + 0)
						fail(sprintf("field %s has invalid step \"%s\"", field_name[i], f))
					continue
				}
				n = split(f, parts, ",")
				for (j = 1; j <= n; j++) {
					p = parts[j]
					if (p == "") {
						fail(sprintf("field %s contains an empty token", field_name[i]))
						continue
					}
					if (p ~ /^[0-9]+-[0-9]+$/) {
						split(p, rng, "-")
						if (rng[1]+0 < minv[i]+0 || rng[1]+0 > maxv[i]+0)
							fail(sprintf("field %s has out-of-range token \"%s\"", field_name[i], p))
						if (rng[2]+0 < minv[i]+0 || rng[2]+0 > maxv[i]+0)
							fail(sprintf("field %s has out-of-range token \"%s\"", field_name[i], p))
						if (rng[1]+0 > rng[2]+0)
							fail(sprintf("field %s has inverted range \"%s\"", field_name[i], p))
					} else if (p ~ /^[0-9]+$/) {
						if (p+0 < minv[i]+0 || p+0 > maxv[i]+0)
							fail(sprintf("field %s has out-of-range token \"%s\"", field_name[i], p))
					} else {
						fail(sprintf("field %s has invalid token \"%s\"", field_name[i], p))
					}
				}
			}
		}
		END {
			if (!valid)
				printf "%s", error
			exit(valid ? 0 : 1)
		}
	'
	)"; then
		CRON_VALIDATION_ERROR=''
		return 0
	fi

	CRON_VALIDATION_ERROR="$validation_output"
	return 1
}

normalize_cron_schedule() {
	local schedule="$1"
	local minute hour dom month dow

	set -f
	# shellcheck disable=SC2086 # Cron validation guarantees exactly five fields.
	set -- $schedule
	set +f
	minute="${1:-}"
	hour="${2:-}"
	dom="${3:-}"
	month="${4:-}"
	dow="${5:-}"

	case "$minute" in
		'*'|'*/1'|'*/2'|'*/3'|'*/4')
			printf '*/5 %s %s %s %s\n' "$hour" "$dom" "$month" "$dow"
			;;
		*)
			printf '%s\n' "$schedule"
			;;
	esac
}

install_cron_hook() {
	local config_ready="${1:-0}"
	local tmp_cron=''
	local effective_cron_schedule=''

	if [ "$config_ready" != '1' ]; then
		load_service_config
	fi
	mkdir -p /etc/cron.d

	tmp_cron="$(mktemp /tmp/nordvpn-easy.cron.XXXXXX 2>/dev/null)" || {
		log_service_error 'failed to create temporary cron hook file'
		return 1
	}

	if ! write_desired_cron_hook_to "$tmp_cron" "$config_ready"; then
		rm -f "$CRON_PATH"
		rm -f -- "$tmp_cron"
		log_service_error "invalid cron schedule '$cfg_check_cron_schedule' (${CRON_VALIDATION_ERROR:-unknown error}); refusing to write $CRON_PATH"
		return 1
	fi

	if [ -f "$CRON_PATH" ] && cmp -s "$tmp_cron" "$CRON_PATH" 2>/dev/null; then
		rm -f -- "$tmp_cron"
		log_service_info "cron hook unchanged at $CRON_PATH"
		return 0
	fi

	if [ -s "$tmp_cron" ]; then
		effective_cron_schedule="$(normalize_cron_schedule "$cfg_check_cron_schedule")"
		if [ "$effective_cron_schedule" != "$cfg_check_cron_schedule" ]; then
			log_service_info "cron schedule '$cfg_check_cron_schedule' is faster than the 5-minute minimum; using '$effective_cron_schedule'"
		fi
		mv "$tmp_cron" "$CRON_PATH" || {
			rm -f -- "$tmp_cron"
			return 1
		}
		log_service_info "installed cron hook at $CRON_PATH with schedule '$effective_cron_schedule'"
		restart_cron_service
	else
		rm -f -- "$tmp_cron"
		if [ -f "$CRON_PATH" ]; then
			rm -f "$CRON_PATH"
			log_service_info "removed cron hook from $CRON_PATH"
			restart_cron_service
		else
			log_service_info "removed cron hook from $CRON_PATH"
		fi
	fi
}

install_hotplug_hook() {
	local config_ready="${1:-0}"
	local tmp_hotplug=''

	if [ "$config_ready" != '1' ]; then
		load_service_config
	fi
	mkdir -p /etc/hotplug.d/iface

	if [ "$cfg_enabled" -ne 1 ] || [ "$cfg_enable_hotplug" -ne 1 ]; then
		if [ -f "$HOTPLUG_PATH" ]; then
			rm -f "$HOTPLUG_PATH"
			log_service_info "removed hotplug hook from $HOTPLUG_PATH"
		else
			log_service_info "removed hotplug hook from $HOTPLUG_PATH"
		fi
		return 0
	fi

	tmp_hotplug="$(mktemp /tmp/nordvpn-easy.hotplug.XXXXXX 2>/dev/null)" || {
		log_service_error 'failed to create temporary hotplug hook file'
		return 1
	}

	cat > "$tmp_hotplug" <<EOF
#!/bin/sh
WAN_IF='$(nordvpn_easy_shell_quote "$cfg_wan_if")'
VPN_IF='$(nordvpn_easy_shell_quote "$cfg_vpn_if")'
DEBOUNCE_SECONDS='$(nordvpn_easy_shell_quote "$cfg_hotplug_debounce_seconds")'
RUN_DIR='/tmp/run/nordvpn-easy'
LOCK_DIR='/tmp/nordvpn-easy.lock'
STAMP_FILE="\$RUN_DIR/hotplug.last"

case "\$ACTION" in
	ifup|ifupdate|ifdown) ;;
	*) exit 0 ;;
esac

[ "\$INTERFACE" = "\$WAN_IF" ] || [ "\$INTERFACE" = "\$VPN_IF" ] || exit 0

case "\$DEBOUNCE_SECONDS" in
	''|*[!0-9]*)
		DEBOUNCE_SECONDS='30'
		;;
esac

mkdir -p "\$RUN_DIR" 2>/dev/null || true
NOW_TS="\$(date +%s 2>/dev/null || printf '%s' '0')"
LAST_TS="\$(cat "\$STAMP_FILE" 2>/dev/null || printf '%s' '0')"
case "\$NOW_TS:\$LAST_TS" in
	*[!0-9:]*|0:*)
		LAST_TS='0'
		;;
esac

if [ "\$LAST_TS" -gt 0 ] && [ \$((NOW_TS - LAST_TS)) -lt "\$DEBOUNCE_SECONDS" ]; then
	logger -t $SERVICE_NAME-hotplug "debounced \$ACTION for \$INTERFACE (last=\${LAST_TS}, debounce=\${DEBOUNCE_SECONDS}s)"
	exit 0
fi

printf '%s\n' "\$NOW_TS" > "\$STAMP_FILE" 2>/dev/null || true

if [ -f "\$RUN_DIR/connect-apply-guard" ]; then
	logger -t $SERVICE_NAME-hotplug "skipped \$ACTION for \$INTERFACE during connect apply"
	exit 0
fi

if [ -r "\$LOCK_DIR/pid" ]; then
	LOCK_PID="\$(cat "\$LOCK_DIR/pid" 2>/dev/null || true)"
	case "\$LOCK_PID" in
		''|*[!0-9]*)
			;;
		*)
			if kill -0 "\$LOCK_PID" 2>/dev/null; then
				LOCK_ACTION="\$(cat "\$LOCK_DIR/action" 2>/dev/null || printf '%s' 'unknown')"
				LOCK_STARTED_AT="\$(cat "\$LOCK_DIR/started_at" 2>/dev/null || printf '%s' '0')"
				case "\$LOCK_STARTED_AT" in
					''|*[!0-9]*)
						LOCK_AGE='0'
						;;
					*)
						LOCK_AGE=\$((NOW_TS - LOCK_STARTED_AT))
						[ "\$LOCK_AGE" -ge 0 ] || LOCK_AGE='0'
						;;
				esac
				logger -t $SERVICE_NAME-hotplug "skipped \$ACTION for \$INTERFACE because runtime operation is busy (holder_action=\$LOCK_ACTION, holder_pid=\$LOCK_PID, holder_age_seconds=\$LOCK_AGE)"
				exit 0
			fi
			;;
	esac
fi

NORDVPN_EASY_BUSY_IS_OK=1 /etc/init.d/$SERVICE_NAME check 2>&1 | logger -t $SERVICE_NAME-hotplug
EOF

	if [ -f "$HOTPLUG_PATH" ] && cmp -s "$tmp_hotplug" "$HOTPLUG_PATH" 2>/dev/null; then
		rm -f -- "$tmp_hotplug"
		log_service_info "hotplug hook unchanged at $HOTPLUG_PATH"
		return 0
	fi

	mv "$tmp_hotplug" "$HOTPLUG_PATH" || {
		rm -f -- "$tmp_hotplug"
		return 1
	}
	chmod 755 "$HOTPLUG_PATH"
	log_service_info "installed hotplug hook at $HOTPLUG_PATH for wan_if=$cfg_wan_if vpn_if=$cfg_vpn_if"
}

install_hooks_if_needed() {
	load_service_config || return 1
	log_service_info "install_hooks requested with $(nordvpn_easy_service_debug_summary 'cfg_')"
	log_service_info 'installing runtime hooks'
	install_cron_hook 1 || return 1
	install_hotplug_hook 1 || return 1
	log_service_info 'runtime hooks installed'
}

install_hooks() {
	install_hooks_if_needed
}

remove_hooks() {
	log_service_info 'removing runtime hooks'
	rm -f "$CRON_PATH" "$HOTPLUG_PATH"
	restart_cron_service
	log_service_info 'runtime hooks removed'
}

disable_vpn_runtime() {
	load_service_config
	log_service_info "enabled flag is $(nordvpn_easy_enabled_flag_label "${cfg_enabled:-0}"); disabling VPN runtime with $(nordvpn_easy_service_debug_summary 'cfg_')"
	remove_hooks

	if [ "$(uci -q get "network.${cfg_vpn_if}.proto" 2>/dev/null)" != 'wireguard' ]; then
		log_service_info "no WireGuard interface named $cfg_vpn_if is currently configured"
		return 0
	fi

	log_service_info "WireGuard interface $cfg_vpn_if will be marked disabled; the UCI configuration is kept and the interface is not removed"
	uci set "network.${cfg_vpn_if}.disabled"='1'
	uci commit network || {
		log_service_error "failed to commit network while disabling ${cfg_vpn_if}"
		return 1
	}
	log_service_info "marked network.${cfg_vpn_if}.disabled=1"

	ifdown "$cfg_vpn_if" >/dev/null 2>&1 || true
	log_service_info "requested ifdown for $cfg_vpn_if"

	/etc/init.d/network reload >/dev/null 2>&1 ||
	/etc/init.d/network restart >/dev/null 2>&1 || {
		log_service_error "failed to reload network while disabling ${cfg_vpn_if}"
		return 1
	}
	log_service_info "VPN runtime disabled for interface $cfg_vpn_if; it may now appear as not present until re-enabled"
}

start() {
	local previous_failure_log_mode="${RUN_CORE_ACTION_FAILURE_LOG_MODE-}"

	load_service_config
	log_service_info 'service start requested'

	if [ "$cfg_enabled" -ne 1 ]; then
		disable_vpn_runtime || return 1
		echo "$SERVICE_NAME is disabled in UCI; hooks removed and VPN interface disabled."
		return 0
	fi

	install_hooks || return 1

	# Use the reconcile command path (not only the core reconcile action) so a
	# missing/disabled wg0 at boot runs connect/setup like Save & Apply does.
	RUN_CORE_ACTION_FAILURE_LOG_MODE='info'
	if ! reconcile; then
		log_service_info 'service: initial reconcile failed; hooks are installed and future cron/hotplug runs will retry'
	fi
	RUN_CORE_ACTION_FAILURE_LOG_MODE="$previous_failure_log_mode"
}

stop() {
	log_service_info 'service stop requested'
	remove_hooks
}

restart() {
	log_service_info 'service restart requested'
	stop
	start
}

reload() {
	log_service_info 'service reload requested'
	restart
}

connect() {
	local rc=0

	load_service_config || return 1
	log_service_info "connect requested; enabling runtime transactionally; $(nordvpn_easy_service_debug_summary 'cfg_')"
	uci set "${UCI_CONFIG}.${UCI_SECTION}.enabled=1" || {
		log_service_error 'connect failed while setting enabled=1'
		return 1
	}
	uci commit "$UCI_CONFIG" || {
		log_service_error 'connect failed while committing enabled=1'
		return 1
	}

	connect_apply_guard_begin
	prepare_connect_setup_config_cache || {
		connect_apply_result_finish 1
		connect_apply_guard_end
		return 1
	}

	export NORDVPN_EASY_SETUP_CONFIG_CACHE="$CONNECT_SETUP_CONFIG_CACHE"
	setup || rc=$?
	unset NORDVPN_EASY_SETUP_CONFIG_CACHE
	rm -f "$CONNECT_SETUP_CONFIG_CACHE" 2>/dev/null || true

	if [ "$rc" -ne 0 ]; then
		connect_apply_result_finish "$rc"
		connect_apply_guard_end
		return "$rc"
	fi

	install_hooks_if_needed || {
		connect_apply_result_finish 1
		connect_apply_guard_end
		return 1
	}

	connect_apply_result_finish 0
	connect_apply_guard_end
}

disconnect() {
	load_service_config || return 1
	log_service_info "disconnect requested; disabling runtime transactionally; $(nordvpn_easy_service_debug_summary 'cfg_')"
	uci set "${UCI_CONFIG}.${UCI_SECTION}.enabled=0" || {
		log_service_error 'disconnect failed while setting enabled=0'
		return 1
	}
	uci commit "$UCI_CONFIG" || {
		log_service_error 'disconnect failed while committing enabled=0'
		return 1
	}
	disable_vpn_runtime
}

stop_vpn() {
	log_service_info 'stop_vpn requested; stopping VPN runtime and clearing server caches'
	run_core_action stop_vpn || return $?
}

reconnect() {
	load_service_config || return 1
	log_service_info "reconnect requested (compatibility: stop_vpn then connect); $(nordvpn_easy_service_debug_summary 'cfg_')"
	if [ "$cfg_enabled" -ne 1 ]; then
		log_service_error 'reconnect refused because enabled=0; use connect to enable the runtime'
		return 1
	fi
	stop_vpn || return $?
	connect
}

reconcile() {
	local previous_failure_log_mode="${RUN_CORE_ACTION_FAILURE_LOG_MODE-}"
	local vpn_proto vpn_disabled rc

	load_service_config || return 1
	log_service_info "reconcile requested; synchronizing runtime with saved config; $(nordvpn_easy_service_debug_summary 'cfg_')"

	if [ "$cfg_enabled" -ne 1 ]; then
		log_service_info 'reconcile: saved config is disabled; ensuring runtime is disabled'
		disable_vpn_runtime
		return $?
	fi

	if [ -z "$cfg_nordvpn_token" ]; then
		log_service_error 'reconcile refused because nordvpn_token is missing'
		return 1
	fi

	vpn_proto="$(uci -q get "network.${cfg_vpn_if}.proto" 2>/dev/null || true)"
	vpn_disabled="$(uci -q get "network.${cfg_vpn_if}.disabled" 2>/dev/null || true)"
	if [ "$vpn_proto" != 'wireguard' ] || [ "$vpn_disabled" = '1' ]; then
		log_service_info "reconcile: ${cfg_vpn_if} is not active/configured (proto=${vpn_proto:-missing}, disabled=${vpn_disabled:-0}); running connect"
		connect
		return $?
	fi

	RUN_CORE_ACTION_FAILURE_LOG_MODE='info'
	if run_core_action reconcile; then
		RUN_CORE_ACTION_FAILURE_LOG_MODE="$previous_failure_log_mode"
		install_hooks
		return $?
	fi
	rc=$?
	RUN_CORE_ACTION_FAILURE_LOG_MODE="$previous_failure_log_mode"

	if [ "$rc" -eq "${NORDVPN_EASY_RC_BUSY:-75}" ]; then
		log_service_info 'reconcile skipped because another operation is running'
		return "$rc"
	fi

	log_service_info 'reconcile: runtime reconciliation did not validate the runtime; running stop_vpn then connect'
	stop_vpn || return $?
	connect
}

setup() {
	load_service_config || return 1
	log_service_info "setup requested; enabled flag is $(nordvpn_easy_enabled_flag_label "${cfg_enabled:-0}"); $(nordvpn_easy_service_debug_summary 'cfg_')"
	run_core_action setup
}

check() {
	log_service_info 'manual health-check requested'
	run_core_action check
}

rotate() {
	log_service_info 'manual rotate requested'
	run_core_action rotate
}

refresh_countries() {
	log_service_info 'country cache refresh requested'
	run_core_action refresh_countries
}

refresh_countries_force() {
	log_service_info 'forced country cache refresh requested'
	run_core_action refresh_countries_force
}

server_catalog() {
	local country_query="${1:-}"
	local force_refresh="${2:-0}"

	log_service_info "server catalog requested (country=${country_query:-configured}, force=${force_refresh})"
	run_core_action server_catalog "$country_query" "$force_refresh"
}

public_ip() {
	[ -x "$PUBLIC_IP_POLL_SCRIPT" ] || {
		echo "Missing executable public IP poll script: $PUBLIC_IP_POLL_SCRIPT" >&2
		return 1
	}

	"$PUBLIC_IP_POLL_SCRIPT" "$@"
}

operation_status() {
	run_core_action operation_status
}

vpn_status() {
	run_core_action vpn_status
}

status_json() {
	run_core_action status_json
}

diagnostics_log() {
	log_service_info 'diagnostics log export requested'
	run_core_action diagnostics_log
}

diagnostics_summary() {
	run_core_action diagnostics_summary
}

disable_runtime() {
	load_service_config || return 1
	log_service_info "disable_runtime requested; enabled flag is $(nordvpn_easy_enabled_flag_label "${cfg_enabled:-0}"); $(nordvpn_easy_service_debug_summary 'cfg_')"
	disable_vpn_runtime
}
