#!/bin/sh
# reconnect/reconcile can exceed stock rpcd (30s) and uhttpd script_timeout (60s).

MIN_RPCD_TIMEOUT=180
MIN_UHTTPD_SCRIPT_TIMEOUT=180
MIN_UHTTPD_NETWORK_TIMEOUT=180
CHANGED=0

bump_uci_min() {
	local package="$1"
	local section="$2"
	local option="$3"
	local min="$4"
	local current

	current="$(uci -q get "${package}.${section}.${option}" 2>/dev/null || echo 0)"
	case "$current" in
	''|*[!0-9]*) current=0 ;;
	esac

	[ "$current" -ge "$min" ] && return 0

	uci -q set "${package}.${section}.${option}=${min}" || return 0
	CHANGED=1
}

if ! uci -q get rpcd.@rpcd[0] >/dev/null 2>&1; then
	uci -q add rpcd rpcd >/dev/null 2>&1 || exit 0
	uci -q set rpcd.@rpcd[0].socket='/var/run/ubus/ubus.sock' 2>/dev/null || true
fi

bump_uci_min rpcd '@rpcd[0]' timeout "$MIN_RPCD_TIMEOUT"

if uci -q get uhttpd.main >/dev/null 2>&1; then
	bump_uci_min uhttpd main script_timeout "$MIN_UHTTPD_SCRIPT_TIMEOUT"
	bump_uci_min uhttpd main network_timeout "$MIN_UHTTPD_NETWORK_TIMEOUT"
fi

[ "$CHANGED" -eq 0 ] && exit 0

uci -q commit rpcd 2>/dev/null || true
uci -q commit uhttpd 2>/dev/null || true
/etc/init.d/rpcd restart >/dev/null 2>&1 || true
/etc/init.d/uhttpd restart >/dev/null 2>&1 || true

exit 0
