{
	"luci-app-nordvpn-easy": {
		"description": "Grant access to NordVPN Easy configuration and actions",
		"read": {
			"uci": [
				"nordvpn_easy"
			],
			"file": {
				"/etc/hotplug.d/iface/95-nordvpn-easy": [
					"read"
				],
				"/tmp/nordvpn-easy-countries.json": [
					"read"
				],
				"/tmp/nordvpn-easy-servers.json": [
					"read"
				]
			},
			"ubus": {
				"nordvpn.easy": [
					"status",
					"diagnostics",
					"diagnostics_log",
					"diagnostics_summary",
					"public_ip",
					"refresh_countries",
					"server_catalog"
				]
			}
		},
		"write": {
			"uci": [
				"nordvpn_easy"
			],
			"ubus": {
				"uci": [
					"commit"
				],
				"nordvpn.easy": [
					"connect",
					"start_connect",
					"begin_connect_apply",
					"abort_connect_apply",
					"apply",
					"stop_vpn",
					"reconcile",
					"rotate",
					"setup",
					"check",
					"install_hooks",
					"remove_hooks",
					"refresh_countries",
					"server_catalog",
					"public_ip",
					"diagnostics",
					"diagnostics_log",
					"diagnostics_summary"
				]
			}
		}
	}
}
