{
	"luci-app-nordvpn-easy": {
		"description": "Grant access to NordVPN Easy configuration and actions",
		"read": {
			"uci": [
				"nordvpn_easy"
			],
			"file": {
				"/etc/cron.d/nordvpn-easy": [
					"read"
				],
				"/etc/hotplug.d/iface/95-nordvpn-easy": [
					"read"
				],
				"/tmp/nordvpn-easy-countries.json": [
					"read"
				],
				"/tmp/nordvpn-easy-servers.json": [
					"read"
				],
				"/tmp/run/nordvpn-easy/status.json": [
					"read"
				]
			},
			"ubus": {
				"nordvpn.easy": [
					"status",
					"diagnostics",
					"diagnostics_log",
					"public_ip",
					"public_country",
					"refresh_countries",
					"refresh_servers",
					"server_catalog"
				]
			}
		},
		"write": {
			"uci": [
				"nordvpn_easy"
			],
			"ubus": {
				"nordvpn.easy": [
					"connect",
					"disconnect",
					"reconnect",
					"reconcile",
					"rotate",
					"setup",
					"check",
					"install_hooks",
					"remove_hooks",
					"disable_runtime",
					"refresh_countries",
					"refresh_servers",
					"server_catalog",
					"public_ip",
					"public_country",
					"diagnostics",
					"diagnostics_log"
				]
			}
		}
	}
}
